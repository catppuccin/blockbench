#preview {
  --color-axis-x: inherit;
  --color-axis-y: inherit;
  --color-axis-z: inherit;
  --color-axis-u: inherit;
  --color-axis-v: inherit;
  --color-axis-w: inherit;
}
[style^="background-color: var(--color-stream)"] {
  color: #1e1e2e !important;
}